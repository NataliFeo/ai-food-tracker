[Unit]
Description=AI Food Tracker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=foodtracker
Group=foodtracker
WorkingDirectory=/opt/food-tracker/current
EnvironmentFile=/etc/food-tracker.env
ExecStart=/usr/local/bin/node server.js
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/food-tracker /opt/food-tracker/current/.next/cache
UMask=0077

[Install]
WantedBy=multi-user.target
